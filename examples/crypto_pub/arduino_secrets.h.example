// Copy this file to arduino_secrets.h (gitignored) and fill in real values.
#pragma once

#define SECRET_WIFI_SSID "your-ssid"
#define SECRET_WIFI_PASS "your-password"
#define SECRET_BROKER_HOST "192.168.1.10" // the mads-broker's IP

// ---------------------------------------------------------------------------
// CURVE keys. Generate them on the PC, never on the board:
//
//   mads --keypair=uno_r4     -> uno_r4.key (secret) and uno_r4.pub
//
// Each file is a single 40-character Z85 line with no trailing newline.
// Paste them below verbatim.
//
// Then copy uno_r4.pub into the broker's keys directory ($(mads -p)/etc by
// default, or wherever --keys_dir points) and RESTART THE BROKER: it scans
// for *.pub only at startup, and a broker that missed the restart rejects
// this board exactly as if the key were unknown.
//
// SECRET_CURVE_BROKER_PUBLIC is the *broker's* broker.pub, not yours.
//
// Read this before pasting the secret: the .key line below is a private key
// going into source. arduino_secrets.h is gitignored, but the *compiled
// binary* carries it in plaintext and the UNO R4's bootloader is open, so
// anyone who can hold the board can read the key off it. That is the
// accepted trade -- CURVE defends against a network attacker, not against
// physical possession. It also means one build = one identity: flash this
// same file to five boards and the broker cannot tell them apart, because
// ZAP allow-lists by public key. If per-board identity matters, generate
// uno_r4_01, uno_r4_02, ... and build once per board.
// ---------------------------------------------------------------------------
#define SECRET_CURVE_CLIENT_PUBLIC "paste-the-40-chars-from-uno_r4.pub------"
#define SECRET_CURVE_CLIENT_SECRET "paste-the-40-chars-from-uno_r4.key------"
#define SECRET_CURVE_BROKER_PUBLIC "paste-the-40-chars-from-broker.pub------"
